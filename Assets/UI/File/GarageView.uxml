<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/base.uss?fileID=7433441132597879392&amp;guid=92cb09e88af8a8641b907a6c643b8511&amp;type=3#base"/>
    <Style src="project://database/Assets/UI/Styles/tailwindcss_base.uss?fileID=7433441132597879392&amp;guid=355bdeddf02e75247b03301baba68a71&amp;type=3#tailwindcss_base"/>
    <Style src="project://database/Assets/UI/Styles/root.uss?fileID=7433441132597879392&amp;guid=4ddc5132678afbf408db7c41bc4e926d&amp;type=3#root"/>
    <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; flex-direction: row;">
        <ui:VisualElement name="Overlay3Models" picking-mode="Ignore" style="align-items: center; width: 330px;">
            <ui:Button text=" " name="ButtonPrevTower" class="button button-secondary" style="font-size: 50px; rotate: 90deg;">
                <ui:VisualElement name="SpriteArrow" class="icon" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/Placeholder.png?fileID=2800000&amp;guid=52e2e5bc9595d0149b1bea9ad4aa1487&amp;type=3#Placeholder&quot;); rotate: 180deg;"/>
            </ui:Button>
            <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1;"/>
            <ui:Button text="" name="ButtonNextTower" class="button button-secondary" style="font-size: 50px; rotate: 90deg;">
                <ui:VisualElement name="SpriteArrow" class="icon" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/Placeholder.png?fileID=2800000&amp;guid=52e2e5bc9595d0149b1bea9ad4aa1487&amp;type=3#Placeholder&quot;);"/>
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1;">
            <ui:VisualElement style="flex-grow: 0; flex-shrink: 0; height: 100%;">
                <ui:VisualElement picking-mode="Ignore" class="p-2" style="flex-grow: 1; flex-shrink: 0;">
                    <ui:VisualElement picking-mode="Ignore" style="flex-grow: 0; flex-direction: row;">
                        <ui:VisualElement style="flex-grow: 1; align-items: flex-end;">
                            <ui:VisualElement picking-mode="Ignore" class="bg_accent">
                                <ui:Label text="Label" name="MachineName" class="font-bold font p-2 text-2xl text-white"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; align-items: flex-start;">
                        <ui:VisualElement name="BoxRepair" class="p-4 panel-primary" style="flex-grow: 0; align-items: flex-start;">
                            <ui:Label text="Label" name="TextRepair" class="m-1 text-lg font-bold text-white"/>
                            <ui:VisualElement style="flex-grow: 0; flex-direction: row; flex-shrink: 0;">
                                <ui:Button text="#btn_repair" name="ButtonRepair" class="button button-accent-fill"/>
                                <ui:Button text="#btn_repair_adv" name="ButtonRepairByAdv" class="button button-accent-fill"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:ScrollView mode="Horizontal" horizontal-scroller-visibility="Auto" class="w-96" style="flex-direction: row;">
                            <ui:VisualElement class="w-64 h-32 panel-primary" style="flex-shrink: 0;">
                                <ui:Button text="" name="ButtonBody" class="button button-primary flex-col items-center p-0 m-0 p-1">
                                    <ui:Image class="icon2_1" style="background-image: url(&quot;project://database/Assets/Sprites/Use/BodyIcon.png?fileID=2800000&amp;guid=280d653808899b8419741ed5847149ad&amp;type=3#BodyIcon&quot;);"/>
                                    <ui:Label text="#btn_body"/>
                                </ui:Button>
                            </ui:VisualElement>
                            <ui:VisualElement class="w-64 h-32 panel-primary" style="flex-shrink: 0;">
                                <ui:Button text="" name="ButtonBody" class="button button-primary flex-col items-center p-0 m-0 p-1">
                                    <ui:Image class="icon2_1" style="background-image: url(&quot;project://database/Assets/Sprites/Use/BodyIcon.png?fileID=2800000&amp;guid=280d653808899b8419741ed5847149ad&amp;type=3#BodyIcon&quot;);"/>
                                    <ui:Label text="#btn_body"/>
                                </ui:Button>
                            </ui:VisualElement>
                            <ui:VisualElement class="w-64 h-32 panel-secondary" style="flex-shrink: 0;">
                                <ui:Button text="" name="ButtonBody" class="button button-primary flex-col items-center p-0 m-0 p-1">
                                    <ui:Image class="icon2_1" style="background-image: url(&quot;project://database/Assets/Sprites/Use/BodyIcon.png?fileID=2800000&amp;guid=280d653808899b8419741ed5847149ad&amp;type=3#BodyIcon&quot;);"/>
                                    <ui:Label text="#btn_body"/>
                                </ui:Button>
                            </ui:VisualElement>
                            <ui:VisualElement class="w-64 h-32 panel-primary" style="flex-shrink: 0;"/>
                            <ui:VisualElement class="w-64 h-32 panel-primary" style="flex-shrink: 0;"/>
                            <ui:VisualElement class="w-64 h-32 panel-primary" style="flex-shrink: 0;"/>
                            <ui:VisualElement class="w-64 h-32 panel-primary" style="flex-shrink: 0;"/>
                            <ui:VisualElement class="w-64 h-32 panel-primary" style="flex-shrink: 0;"/>
                        </ui:ScrollView>
                    </ui:VisualElement>
                    <ui:VisualElement name="DialogWrapper" picking-mode="Ignore" style="flex-grow: 1; position: absolute; top: 0; left: 3px; bottom: 0; right: -2px; align-items: center; justify-content: center;">
                        <ui:VisualElement name="GarageWrapper" picking-mode="Ignore" style="width: 415px; flex-grow: 1;">
                            <ui:VisualElement name="Tabs" picking-mode="Ignore"/>
                            <ui:ScrollView name="MachineBox" picking-mode="Ignore"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="p-2" style="flex-grow: 1;">
                    <ui:VisualElement picking-mode="Ignore" name="BoxNextPrev" style="flex-direction: row;">
                        <ui:Button text=" " name="ButtonPrev" class="button button-secondary" style="font-size: 50px;">
                            <ui:VisualElement name="SpriteArrow" class="icon" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/Placeholder.png?fileID=2800000&amp;guid=52e2e5bc9595d0149b1bea9ad4aa1487&amp;type=3#Placeholder&quot;); rotate: 180deg;"/>
                        </ui:Button>
                        <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1;"/>
                        <ui:Button text="" name="ButtonNext" class="button button-secondary" style="font-size: 50px;">
                            <ui:VisualElement name="SpriteArrow" class="icon" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/Placeholder.png?fileID=2800000&amp;guid=52e2e5bc9595d0149b1bea9ad4aa1487&amp;type=3#Placeholder&quot;);"/>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1;"/>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore">
                    <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; flex-direction: row;">
                        <ui:Button text="" name="ButtonBody" class="button button-primary flex-col items-center p-0 m-0 p-1">
                            <ui:Image class="icon2_1" style="background-image: url(&quot;project://database/Assets/Sprites/Use/BodyIcon.png?fileID=2800000&amp;guid=280d653808899b8419741ed5847149ad&amp;type=3#BodyIcon&quot;);"/>
                            <ui:Label text="#btn_body"/>
                        </ui:Button>
                        <ui:Button text="" name="ButtonTower" class="button button-primary flex-col items-center p-0 m-0 p-1">
                            <ui:Image class="icon2_1" style="background-image: url(&quot;project://database/Assets/Sprites/Use/IconTower.png?fileID=2800000&amp;guid=f1ee8726670d1e749b340f10f4d4ff99&amp;type=3#IconTower&quot;);"/>
                            <ui:Label text="#btn_tower"/>
                        </ui:Button>
                        <ui:Button text="" name="ButtonWheel" class="button button-primary flex-col items-center p-0 m-0 p-1">
                            <ui:Image class="icon2_1" style="background-image: url(&quot;project://database/Assets/Sprites/Use/WheelIcon.png?fileID=2800000&amp;guid=d53af0fd94591d04dacc2781e7721698&amp;type=3#WheelIcon&quot;);"/>
                            <ui:Label text="#btn_wheel"/>
                        </ui:Button>
                        <ui:Button text="#btn_close" name="ButtonTowerClose" class="button button-primary"/>
                        <ui:VisualElement style="flex-grow: 0; flex-direction: row;">
                            <ui:Button text="#btn_sell" name="ButtonSell_del" class="button button-accent" style="display: none;"/>
                            <ui:Button text="" name="ButtonSell" class="button button-primary flex-col items-center p-0 m-0 p-1">
                                <ui:Image class="icon2_1" style="background-image: url(&quot;project://database/Assets/Sprites/Use/IconPrice.png?fileID=2800000&amp;guid=0fdfa7e8ac1cf81489fe66e66f49d948&amp;type=3#IconPrice&quot;);"/>
                                <ui:Label text="#btn_sell"/>
                            </ui:Button>
                            <ui:Button name="ButtonOpenColors" class="button button-primary-fill" style="flex-direction: row;">
                                <ui:Image name="SpriteFill" class="icon" style="background-image: url(&quot;project://database/Assets/Sprites/Placeholder.png?fileID=2800000&amp;guid=52e2e5bc9595d0149b1bea9ad4aa1487&amp;type=3#Placeholder&quot;);"/>
                                <ui:Label text="#btn_open_colors" class="p-0 m-0 ml-2"/>
                            </ui:Button>
                            <ui:Button text="#btn_cancel_colors" name="ButtonCancelColor" class="button button-secondary"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; position: absolute; top: 5px; left: 5px; right: 5px; height: 100%;">
                <ui:VisualElement name="Hint" picking-mode="Ignore" class="panel_accent" style="position: relative;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
