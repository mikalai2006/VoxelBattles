        </ui:VisualElement>
        <ui:VisualElement picking-mode="Ignore">
            <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; flex-direction: row; display: none;">
                <ui:Button text="#btn_tower" name="ButtonTower" class="button"/>
