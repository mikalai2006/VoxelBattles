<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/base.uss?fileID=7433441132597879392&amp;guid=92cb09e88af8a8641b907a6c643b8511&amp;type=3#base"/>
    <ui:VisualElement picking-mode="Ignore" name="" style="flex-grow: 1;">
        <ui:Image name="ImageRenderTexture" style="position: absolute; top: 0; bottom: 0; right: 0; left: 0; background-image: url(&quot;project://database/Assets/UI/RenderingTextures/ShopView.renderTexture?fileID=8400000&amp;guid=37088a31f09643b48ae750284eed0385&amp;type=2#ShopView&quot;); display: none;"/>
        <ui:VisualElement picking-mode="Ignore">
            <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; flex-direction: row;">
                <ui:VisualElement name="InfoBox" style="flex-grow: 1;"/>
                <ui:Button text="#btn_buy" name="ButtonBuy" class="button"/>
                <ui:Button text="" name="ButtonBody" class="button button-primary flex-col items-center p-0 m-0 p-1">
                    <ui:Image class="icon2_1" style="background-image: url(&quot;project://database/Assets/Sprites/Use/IconPrice.png?fileID=2800000&amp;guid=0fdfa7e8ac1cf81489fe66e66f49d948&amp;type=3#IconPrice&quot;);"/>
                    <ui:Label text="#btn_buy"/>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; flex-direction: row; align-items: center;">
            <ui:VisualElement picking-mode="Ignore">
                <ui:Button text="" name="ButtonPrev" class="button" style="font-size: 50px;">
                    <ui:VisualElement name="SpriteArrow" class="icon" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/Placeholder.png?fileID=2800000&amp;guid=52e2e5bc9595d0149b1bea9ad4aa1487&amp;type=3#Placeholder&quot;); rotate: 180deg;"/>
                </ui:Button>
