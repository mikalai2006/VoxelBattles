<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="DialogEntity" src="project://database/Assets/UI%20Toolkit/File/DialogEntity.uxml?fileID=9197481963319205126&amp;guid=3784b972c0197bd419bdac2aedb9672d&amp;type=3#DialogEntity"/>
    <Style src="project://database/Assets/UI/Styles/base.uss?fileID=7433441132597879392&amp;guid=92cb09e88af8a8641b907a6c643b8511&amp;type=3#base"/>
    <Style src="project://database/Assets/UI/Styles/tailwindcss_base.uss?fileID=7433441132597879392&amp;guid=355bdeddf02e75247b03301baba68a71&amp;type=3#tailwindcss_base"/>
    <Style src="project://database/Assets/UI/Styles/root.uss?fileID=7433441132597879392&amp;guid=4ddc5132678afbf408db7c41bc4e926d&amp;type=3#root"/>
    <ui:VisualElement name="Dialog" class="p-0" style="background-color: rgba(0, 0, 0, 0.71); position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: flex; flex-grow: 1; justify-content: center;">
        <ui:VisualElement name="DialogWrapper" style="background-color: rgb(164, 164, 164); align-items: stretch; flex-grow: 0; width: 380px; align-self: center;">
            <ui:VisualElement class="header" style="flex-grow: 1; flex-shrink: 0;">
                <ui:VisualElement class="p-1" style="flex-shrink: 0; align-items: stretch; flex-grow: 1;">
                    <ui:Label tabindex="-1" text="#info" display-tooltip-when-elided="true" name="HeaderText" class="p-2 m-0 text-white text-lg font-bold"/>
                </ui:VisualElement>
                <ui:VisualElement class="p-1" style="flex-shrink: 0; align-items: flex-end;">
                    <ui:Button display-tooltip-when-elided="true" name="CloseBtn" class="button_circle" style="display: none;">
                        <ui:VisualElement style="background-image: url(&quot;project://database/Assets/Sprites/Placeholder.png?fileID=2800000&amp;guid=52e2e5bc9595d0149b1bea9ad4aa1487&amp;type=3#Placeholder&quot;); flex-grow: 1;"/>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement style="background-color: rgba(0, 0, 0, 0);">
                <ui:VisualElement style="background-color: rgba(0, 0, 0, 0); flex-direction: row; flex-grow: 1;">
                    <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" style="flex-grow: 1;">
                        <ui:VisualElement style="flex-grow: 1;">
                            <ui:VisualElement name="Sprite" class="mt-2" style="flex-grow: 1; width: 100px; height: 100px; align-self: center; background-image: url(&quot;project://database/Assets/Sprites/Placeholder.png?fileID=2800000&amp;guid=52e2e5bc9595d0149b1bea9ad4aa1487&amp;type=3#Placeholder&quot;);"/>
                            <ui:Label tabindex="-1" text="Description" display-tooltip-when-elided="true" name="MessageText" class="p-2 text-white" style="flex-grow: 1; white-space: normal; -unity-text-align: upper-center;"/>
                            <ui:VisualElement name="ListEntity" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row; justify-content: center;">
                                <ui:Instance template="DialogEntity" name="DialogEntity"/>
                                <ui:Instance template="DialogEntity" name="DialogEntity"/>
                                <ui:Instance template="DialogEntity" name="DialogEntity"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="p-1" style="flex-direction: row; justify-content: center; flex-shrink: 0;">
                <ui:Button text="cancel" display-tooltip-when-elided="true" name="Cancel" class="button button-secondary"/>
                <ui:Button text="ok" display-tooltip-when-elided="true" name="Ok" class="button button-primary-fill"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
